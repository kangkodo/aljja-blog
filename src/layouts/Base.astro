---
// 모든 페이지의 뼈대: head + 헤더 + main + 푸터
import BaseHead, { type Props as HeadProps } from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import NavProgress from '../components/layout/NavProgress.astro';
import '../styles/global.css';

interface Props extends HeadProps {
  /** 헤더에서 활성화할 메뉴 href */
  active?: string;
  /** main의 폭·여백. 생략하면 기본 768px 레이아웃 */
  class?: string;
}

const { active, class: mainClass = 'max-w-[768px] pt-8 pb-10 sm:pt-12 sm:pb-12', ...head } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...head} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <NavProgress />
    <Header active={active} />
    <main class:list={['mx-auto w-full flex-1 px-4', mainClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
