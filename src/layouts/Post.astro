---
// 글 상세 (UI 명세 5.2). 목차·댓글 없음. 본문 중간 광고는 마크다운 플러그인이 넣는다 (src/lib/ads.ts).
import Base from './Base.astro';
import PostHeader from '../components/post/PostHeader.astro';
import Faq from '../components/post/Faq.astro';
import PostFooter from '../components/post/PostFooter.astro';
import { SITE, AI_DEFENSE_HTML, CANARY_STRING } from '../config';
import { adsOn, adHtml } from '../lib/ads';
import { categoryUrl, ogImageUrl, postUrl, type Post } from '../lib/posts';
import { postJsonLd } from '../lib/seo';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
  related: Post[];
}

const { post, prev, next, related } = Astro.props;
const { title, description, category, tags, faq } = post.data;
const canonical = new URL(postUrl(post), SITE.url).href;
const ogImage = ogImageUrl(post);
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  jsonLd={postJsonLd(post, canonical, new URL(ogImage, SITE.url).href)}
  active={categoryUrl(category)}
  class="relative max-w-[752px] pt-5 pb-10 sm:pt-8 sm:pb-12"
>
  {adsOn('rail') && (
    <aside aria-label="광고" class="absolute top-8 bottom-12 left-[calc(100%+24px)] hidden w-40 xl:block">
      <div class="sticky top-6" set:html={adHtml('rail')} />
    </aside>
  )}

  <div data-pagefind-body>
    <PostHeader post={post} />
    {AI_DEFENSE_HTML && (
      <div aria-hidden="true" data-pagefind-ignore style="font-size:1px;line-height:1px;height:1px;overflow:hidden" set:html={AI_DEFENSE_HTML} />
    )}
    <article class="prose">
      <slot />
    </article>
    <Faq faq={faq} />
  </div>

  <PostFooter tags={tags} prev={prev} next={next} related={related} />

  {CANARY_STRING && <p aria-hidden="true" style="font-size:1px;color:transparent;user-select:none">{CANARY_STRING}</p>}
</Base>
