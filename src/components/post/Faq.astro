---
// 자주 묻는 질문 (항상 펼침). FAQ가 없으면 섹션 없음.
import type { Post } from '../../lib/posts';

interface Props {
  faq: Post['data']['faq'];
}

const { faq } = Astro.props;
---

{faq.length > 0 && (
  <section aria-labelledby="faq" class="mt-11 sm:mt-14">
    <h2 id="faq" class="mb-1.5 t-h2 sm:mb-2">자주 묻는 질문</h2>
    <dl class="border-t border-ink">
      {faq.map(({ q, a }) => (
        <div class="border-b border-border py-4 sm:py-5">
          <dt class="flex gap-2.5 t-strong-sm sm:gap-3"><span class="text-accent">Q</span>{q}</dt>
          <dd class="mt-1.5 pl-[22px] t-body-sm text-text-2 sm:mt-2 sm:pl-[26px]">{a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
