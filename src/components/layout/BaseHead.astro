---
// <head>: SEO 메타, OG, JSON-LD, 폰트, 분석 비콘, 광고 스크립트
import { SITE, ADS, CF_ANALYTICS_TOKEN } from '../../config';
import { adsOn } from '../../lib/ads';
// IBM Plex Sans KR 400·700만 (UI 명세 2.2). Google Fonts 대신 직접 제공해 독자 IP가 Google로 가지 않게 한다.
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/700.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, canonical, ogImage = '/social/alzza-og-1200x630.jpg', ogType = 'website', jsonLd, noindex } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(ogImage, SITE.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
<meta name="naver-site-verification" content="349b36fa25e1ea040ea60ed83a18ec310c2f6b11" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/icons/favicon-32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/icons/favicon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{CF_ANALYTICS_TOKEN && (
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}></script>
)}
{adsOn() && (
  <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>
)}
