---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostList from '../components/list/PostList.astro';
import Pagination from '../components/list/Pagination.astro';
import { SITE, PAGE_SIZE } from '../config';
import { getPosts } from '../lib/posts';

export const getStaticPaths = (async ({ paginate }) => paginate(await getPosts(), { pageSize: PAGE_SIZE })) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Base
  title={page.currentPage === 1 ? SITE.name : `${page.currentPage}페이지`}
  description={SITE.description}
  active="/"
  class="max-w-[768px] pt-8 pb-6 sm:pt-12 sm:pb-8"
>
  <h1 class="sr-only">{SITE.name}</h1>
  <p class="mb-1.5 t-label text-accent sm:mb-2">{SITE.kicker}</p>
  <p class="mb-7 t-h2 sm:mb-10">{SITE.tagline}</p>
  <PostList posts={page.data} showCategory />
  <Pagination page={page} />
</Base>
