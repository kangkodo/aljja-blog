---
import { render } from 'astro:content';
import PostLayout from '../../layouts/Post.astro';
import { getPosts, postSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      prev: posts[i + 1],
      next: posts[i - 1],
      related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3),
    },
  }));
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} prev={prev} next={next} related={related}>
  <Content />
</PostLayout>
