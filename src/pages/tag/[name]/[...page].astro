---
import type { GetStaticPaths } from 'astro';
import Archive from '../../../layouts/Archive.astro';
import { PAGE_SIZE } from '../../../config';
import { getPosts, tagUrl } from '../../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.flatMap((name) =>
    paginate(posts.filter((p) => p.data.tags.includes(name)), { params: { name }, pageSize: PAGE_SIZE }),
  );
}) satisfies GetStaticPaths;

const { name } = Astro.params;
---

<Archive label="태그" heading={`#${name}`} page={Astro.props.page} base={tagUrl(name)} />
