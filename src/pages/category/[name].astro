---
import Archive from '../../layouts/Archive.astro';
import { getPosts, getCategories, categoryUrl } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getCategories(posts).map((name) => ({
    params: { name },
    props: { posts: posts.filter((p) => p.data.category === name) },
  }));
}

const { name } = Astro.params;
---

<Archive label="카테고리" heading={name} posts={Astro.props.posts} active={categoryUrl(name)} />
