---
import type { GetStaticPaths } from 'astro';
import Archive from '../../../layouts/Archive.astro';
import { PAGE_SIZE } from '../../../config';
import { getPosts, getCategories, categoryUrl } from '../../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return getCategories(posts).flatMap((name) =>
    paginate(posts.filter((p) => p.data.category === name), { params: { name }, pageSize: PAGE_SIZE }),
  );
}) satisfies GetStaticPaths;

const { name } = Astro.params;
const url = categoryUrl(name);
---

<Archive label="카테고리" heading={name} page={Astro.props.page} base={url} active={url} />
