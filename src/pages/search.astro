---
// 검색 (UI 명세 5.4): 입력할 때마다 Pagefind로 검색, 상위 10개.
// 헤더 검색에서 넘어온 ?q= 값이 있으면 입력창에 채우고 바로 검색한다.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
---

<Base title="검색" description={`${SITE.name} 사이트 내 검색`}>
  <h1 class="mb-5 t-display sm:mb-6">검색</h1>
  <label for="q" class="sr-only">검색어</label>
  <div class="relative">
    <Icon name="search" size={20} class="pointer-events-none absolute top-[15px] left-3.5 size-[18px] text-muted sm:top-[18px] sm:left-[18px] sm:size-5" />
    <input
      id="q"
      type="search"
      placeholder="검색어를 입력하세요"
      autocomplete="off"
      class="h-[50px] w-full rounded-[10px] border-[1.5px] border-ink bg-white pr-3.5 pl-10 text-base text-ink sm:h-14 sm:pr-[18px] sm:pl-[50px] sm:text-[17px]"
    />
  </div>
  <div id="results" aria-live="polite" class="mt-5 sm:mt-7"></div>

  <script is:inline>
    const input = document.getElementById('q');
    const results = document.getElementById('results');
    let pagefind;

    function message(text) {
      results.innerHTML = '';
      const p = document.createElement('p');
      p.className = 't-body-sm text-text-3 py-7 sm:py-8';
      p.textContent = text;
      results.append(p);
    }

    async function search() {
      const query = input.value.trim();
      if (!query) return results.replaceChildren();
      if (!pagefind) {
        message('검색 중…');
        document.documentElement.toggleAttribute('data-navigating', true); // 상단 로딩 바 (NavProgress)
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
      }
      const found = await pagefind.search(query);
      const data = await Promise.all(found.results.slice(0, 10).map((r) => r.data()));
      document.documentElement.toggleAttribute('data-navigating', false);
      if (input.value.trim() !== query) return; // 더 최근 입력이 있으면 버린다
      if (!data.length) return message('검색 결과가 없습니다.');
      const escaped = query.split(/\s+/).map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      const terms = new RegExp(`(${escaped.join('|')})`, 'gi'); // 캡처 그룹이라 split 결과의 홀수 칸이 일치 부분

      const ul = document.createElement('ul');
      ul.className = 'border-t border-border';
      for (const d of data) {
        const li = document.createElement('li');
        li.className = 'flex flex-col gap-1.5 border-b border-border py-[18px] sm:py-5';
        const a = document.createElement('a');
        a.href = d.url;
        a.className = 't-h3';
        a.textContent = d.meta.title;
        const p = document.createElement('p');
        p.className = 't-body-sm text-text-3';
        // Pagefind는 일치한 단어를 통째로 <mark>한다("연" → 연말정산). 검색어 글자만 다시 칠한다.
        const excerpt = document.createElement('template');
        excerpt.innerHTML = d.excerpt;
        excerpt.content.textContent.split(terms).forEach((part, i) => {
          if (i % 2 === 0) return p.append(part);
          const mark = document.createElement('mark');
          mark.textContent = part;
          p.append(mark);
        });
        li.append(a, p);
        ul.append(li);
      }
      results.replaceChildren(ul);
    }

    input.addEventListener('input', search);
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      input.value = q;
      search();
    }
  </script>
</Base>

<style is:global>
  #results mark {
    background: var(--color-mark);
    color: var(--color-ink);
    padding: 0 2px;
    border-radius: 3px;
  }
</style>
